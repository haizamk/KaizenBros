# =================================================================
# KAIZENBROS DIALYSIS CENTRE - LARAVEL 13 PRODUCTION ENVIRONMENT
# =================================================================
APP_NAME="KaizenBros Dialysis Centre"
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_TIMEZONE="Asia/Kuala_Lumpur"
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# =================================================================
# WHATSAPP NOTIFICATION GATEWAY (FONNTE PROVIDER)
# =================================================================
FONNTE_API_TOKEN=your_fonnte_api_token_here

# =================================================================
# MYSQL 8.x PRIMARY RELATIONAL DATABASE (MANDATORY)
# NOTE: Credentials must never be committed to GitHub.
# =================================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kaizenbros_prod
DB_USERNAME=kaizenbros_user
DB_PASSWORD=YOUR_SECURE_MYSQL_PASSWORD_HERE
DB_STRICT_MODE=true
DB_ENGINE=InnoDB
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# =================================================================
# SESSIONS & CACHE (REDIS OR DATABASE)
# =================================================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database

# =================================================================
# KAIZENBROS CLINIC CONFIGURATION
# =================================================================
KAIZENBROS_KKM_LICENSE="KKM/BPP/2023/HD-8491"
KAIZENBROS_EMERGENCY_HOTLINE="019-3389922"
KAIZENBROS_OFFICIAL_WHATSAPP="60193389922"
KAIZENBROS_MAIN_PHONE="03-87270791"
KAIZENBROS_ADDRESS="27 & 29G, Jalan 5/10, Seksyen 5 Bandar Rinching, 43500 Semenyih, Selangor"
